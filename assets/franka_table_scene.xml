<mujoco model="franka_table_scene">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="Euler"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <default>
    <joint damping="2.0" armature="0.1"/>
    <geom contype="1" conaffinity="1" condim="4" friction="1.2 0.05 0.001"/>
    <default class="panda">
      <material specular="0.5" shininess="0.25"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.05 0.05 0.1" width="512" height="512"/>
    <texture name="plane" type="2d" builtin="checker" rgb1="0.22 0.24 0.28" rgb2="0.32 0.35 0.4" width="512" height="512" mark="cross" markrgb="0.8 0.8 0.8"/>
    <material name="plane_mat" texture="plane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.78 0.58 0.40 1.0" reflectance="0.15" specular="0.3"/>
    <material name="joint_mat" rgba="0.2 0.2 0.2 1.0" specular="0.5"/>
    <material name="robot_mat" rgba="0.95 0.95 0.95 1.0" reflectance="0.3" specular="0.5"/>
    <material name="black" rgba="0.25 0.25 0.25 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="off_white" rgba="0.90 0.92 0.93 1"/>
    <material name="obstacle_mat" rgba="0.4 0.4 0.5 0.6" reflectance="0.1"/>

    <!-- YCB Real Scanned Object Assets (Campbell's Tomato Soup Can) -->
    <mesh name="ycb_soup_mesh" file="assets/ycb/005_tomato_soup_can.msh"/>
    <texture name="ycb_soup_tex" type="2d" file="assets/ycb/005_tomato_soup_can.png"/>
    <material name="ycb_soup_mat" texture="ycb_soup_tex" specular="0.4" shininess="0.3"/>

    <!-- Franka CAD Meshes from MuJoCo Menagerie (Google DeepMind) -->
    <mesh name="link0_c" file="assets/franka/link0.stl"/>
    <mesh name="link1_c" file="assets/franka/link1.stl"/>
    <mesh name="link2_c" file="assets/franka/link2.stl"/>
    <mesh name="link3_c" file="assets/franka/link3.stl"/>
    <mesh name="link4_c" file="assets/franka/link4.stl"/>
    <mesh name="link5_c0" file="assets/franka/link5_collision_0.obj"/>
    <mesh name="link6_c" file="assets/franka/link6.stl"/>
    <mesh name="link7_c" file="assets/franka/link7.stl"/>
    <mesh name="hand_c" file="assets/franka/hand.stl"/>
    <mesh name="finger_c" file="assets/franka/finger_0.obj"/>
  </asset>

  <worldbody>
    <light directional="true" diffuse="0.85 0.85 0.85" specular="0.25 0.25 0.25" pos="0 0 4" dir="0 0 -1"/>
    <light directional="false" diffuse="0.6 0.6 0.6" pos="1 1 2.5"/>

    <!-- Floor -->
    <geom name="floor" type="plane" size="3 3 0.1" material="plane_mat"/>

    <!-- Work Table (Surface at z = 0.37) -->
    <body name="table" pos="0.5 0 0.35">
      <geom name="table_top" type="box" size="0.45 0.55 0.02" material="table_mat"/>
      <geom name="table_leg1" type="cylinder" size="0.03 0.17" pos=" 0.4  0.5 -0.17" material="joint_mat"/>
      <geom name="table_leg2" type="cylinder" size="0.03 0.17" pos="-0.4  0.5 -0.17" material="joint_mat"/>
      <geom name="table_leg3" type="cylinder" size="0.03 0.17" pos=" 0.4 -0.5 -0.17" material="joint_mat"/>
      <geom name="table_leg4" type="cylinder" size="0.03 0.17" pos="-0.4 -0.5 -0.17" material="joint_mat"/>
    </body>

    <!-- Franka Panda CAD Robot Arm Mounted on Table (Z = 0.37) -->
    <body name="panda_link0" pos="0.0 0.0 0.37">
      <geom name="link0_geom" type="mesh" mesh="link0_c" material="joint_mat"/>

      <body name="panda_link1" pos="0 0 0.10">
        <joint name="panda_joint1" type="hinge" axis="0 0 1" range="-2.8973 2.8973"/>
        <geom name="link1_geom" type="mesh" mesh="link1_c" material="robot_mat"/>

        <body name="panda_link2" pos="0 0 0.16">
          <joint name="panda_joint2" type="hinge" axis="0 1 0" range="-1.7628 1.7628"/>
          <geom name="link2_geom" type="mesh" mesh="link2_c" material="robot_mat"/>

          <body name="panda_link3" pos="0 0 0.20">
            <joint name="panda_joint3" type="hinge" axis="0 0 1" range="-2.8973 2.8973"/>
            <geom name="link3_geom" type="mesh" mesh="link3_c" material="robot_mat"/>

            <body name="panda_link4" pos="0.08 0 0.15">
              <joint name="panda_joint4" type="hinge" axis="0 -1 0" range="-3.0718 -0.0698"/>
              <geom name="link4_geom" type="mesh" mesh="link4_c" material="robot_mat"/>

              <body name="panda_link5" pos="0 0 0.20">
                <joint name="panda_joint5" type="hinge" axis="0 0 1" range="-2.8973 2.8973"/>
                <geom name="link5_geom" type="mesh" mesh="link5_c0" material="robot_mat"/>

                <body name="panda_link6" pos="0 0 0.15">
                  <joint name="panda_joint6" type="hinge" axis="0 1 0" range="-0.0175 3.7525"/>
                  <geom name="link6_geom" type="mesh" mesh="link6_c" material="joint_mat"/>

                  <body name="panda_link7" pos="0 0 0.08">
                    <joint name="panda_joint7" type="hinge" axis="0 0 1" range="-2.8973 2.8973"/>
                    <geom name="link7_geom" type="mesh" mesh="link7_c" material="robot_mat"/>

                    <!-- Panda Gripper / Hand -->
                    <body name="panda_hand" pos="0 0 0.06">
                      <geom name="hand_geom" type="mesh" mesh="hand_c" material="joint_mat"/>

                      <!-- Wrist Mounted Camera (Looking directly down toward gripper fingers & table) -->
                      <camera name="wrist_cam" pos="0.05 0.0 0.02" xyaxes="1 0 0 0 -1 0" fovy="65"/>

                      <!-- Left Finger (Joint index 7) -->
                      <body name="panda_leftfinger" pos="0 0.03 0.04">
                        <joint name="panda_finger_joint1" type="slide" axis="0 1 0" range="0.0 0.04"/>
                        <geom name="finger1_geom" type="box" size="0.008 0.005 0.025" material="joint_mat"/>
                      </body>

                      <!-- Right Finger (Joint index 8) -->
                      <body name="panda_rightfinger" pos="0 -0.03 0.04">
                        <joint name="panda_finger_joint2" type="slide" axis="0 -1 0" range="0.0 0.04"/>
                        <geom name="finger2_geom" type="box" size="0.008 0.005 0.025" material="joint_mat"/>
                      </body>

                      <!-- Tool Center Point Site for IK & Tracking -->
                      <site name="panda_tcp" pos="0 0 0.065" size="0.008" rgba="0 1 0 0.8"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Real YCB Target Object (Campbell's Tomato Soup Can) -->
    <body name="target_object" pos="0.5 0 0.40">
      <freejoint name="target_joint"/>
      <geom name="target_geom" type="mesh" mesh="ycb_soup_mesh" material="ycb_soup_mat" mass="0.12" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </body>

    <!-- Occlusion Barrier / Wall -->
    <body name="occlusion_wall" pos="0.42 0.0 0.45">
      <geom name="wall_geom" type="box" size="0.01 0.12 0.06" material="obstacle_mat"/>
    </body>

    <!-- Overhead Camera (Global view of table workspace) -->
    <camera name="overhead_cam" pos="0.65 0.0 1.1" fovy="58" mode="targetbody" target="table"/>
    <!-- Side Camera -->
    <camera name="side_cam" pos="0.5 0.9 0.8" fovy="50" mode="targetbody" target="table"/>
  </worldbody>

  <actuator>
    <!-- 7 Arm Joints Position Actuators -->
    <position name="act_joint1" joint="panda_joint1" kp="600" kv="50" forcerange="-87 87"/>
    <position name="act_joint2" joint="panda_joint2" kp="600" kv="50" forcerange="-87 87"/>
    <position name="act_joint3" joint="panda_joint3" kp="500" kv="40" forcerange="-87 87"/>
    <position name="act_joint4" joint="panda_joint4" kp="500" kv="40" forcerange="-87 87"/>
    <position name="act_joint5" joint="panda_joint5" kp="300" kv="25" forcerange="-12 12"/>
    <position name="act_joint6" joint="panda_joint6" kp="300" kv="20" forcerange="-12 12"/>
    <position name="act_joint7" joint="panda_joint7" kp="300" kv="20" forcerange="-12 12"/>
    <position name="act_finger1" joint="panda_finger_joint1" kp="200" kv="20" forcerange="-20 20"/>
    <position name="act_finger2" joint="panda_finger_joint2" kp="200" kv="20" forcerange="-20 20"/>
  </actuator>

  <keyframe>
    <!-- Home Keyframe with arm raised in pre-grasp configuration -->
    <key name="home" qpos="0.0 -0.5 0.0 -2.0 0.0 1.6 0.785 0.04 0.04 0.5 0.15 0.40 1 0 0 0"/>
  </keyframe>
</mujoco>
